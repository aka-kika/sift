<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- Hardened runtime blocks Apple Events without this. Uninstall hands
         root-owned bundles (App Store installs) to Finder over Apple Events
         (TrashService.finderDelete); macOS still asks the user first, with
         NSAppleEventsUsageDescription from Info.plist. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
